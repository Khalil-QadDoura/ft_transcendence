{
  "name": "wozu-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "minimatch@^10.0.0": "11.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "gen:api": "node scripts/gen-api.mjs",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "legal:sync": "node scripts/legal-content.mjs",
    "legal:check": "node scripts/legal-content.mjs --check",
    "prebuild": "npm run legal:sync"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.13",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
