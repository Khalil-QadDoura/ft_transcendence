{
  "uid": "wozu-infra",
  "title": "WOZU Infrastructure",
  "description": "Scrape target health, PostgreSQL connections, Redis memory and CPU / memory of every container of one compose project (variable project, default this stack) by compose service (INF-09, module M12). Sources: Prometheus itself (up), postgres-exporter, redis-exporter, cAdvisor. Provisioned from infra/grafana/dashboards/infrastructure.json; edit the file, not the UI.",
  "tags": ["wozu", "m12", "infra"],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Compose project",
        "description": "Compose project whose containers the CPU and memory panels show. cAdvisor sees every container on the Docker host; the default is this stack (name: wozu at the top of docker-compose.yml).",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(container_memory_working_set_bytes, container_label_com_docker_compose_project)",
        "query": {
          "qryType": 1,
          "query": "label_values(container_memory_working_set_bytes, container_label_com_docker_compose_project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": { "text": "wozu", "value": "wozu" },
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "links": [
    { "title": "WOZU dashboards", "type": "dashboards", "tags": ["wozu"], "asDropdown": false, "includeVars": false, "keepTime": true }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Target health",
      "description": "One box per Prometheus scrape job: up is 1 when the last scrape of the target worked, 0 when it failed. Stopping an exporter (docker compose stop redis-exporter) turns its box red within one scrape (15 s).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "vertical"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DB connections",
      "description": "Connections open to PostgreSQL, all databases together (pg_stat_database_numbackends from postgres-exporter), against the server limit max_connections. The API's connection pool, the exporter and the test runs each hold some.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max_connections" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(pg_stat_database_numbackends{job=\"postgres\"})",
          "legendFormat": "open connections",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_settings_max_connections{job=\"postgres\"}",
          "legendFormat": "max_connections",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Redis memory",
      "description": "Memory Redis uses for its data (redis_memory_used_bytes from redis-exporter): pub/sub, queues, rate-limit counters, the Celery broker.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "redis_memory_used_bytes{job=\"redis\"}",
          "legendFormat": "used",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Container CPU by compose service",
      "description": "CPU each container of the compose project chosen above (default: this stack) uses, per compose service, over 5 minutes: rate() of cAdvisor's container_cpu_usage_seconds_total (CPU seconds per second). 100 % is one full core. Without the project filter, a db container of another stack on the same Docker host would be added to this one's db line.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 1,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"$project\", container_label_com_docker_compose_service!=\"\"}[5m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container memory by compose service",
      "description": "Memory each container of the compose project chosen above (default: this stack) uses, per compose service: cAdvisor's container_memory_working_set_bytes, the figure Docker and the kernel use before they stop a container for lack of memory. Without the project filter, a db container of another stack on the same Docker host would be added to this one's db line.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=\"$project\", container_label_com_docker_compose_service!=\"\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "range": true
        }
      ]
    }
  ]
}
