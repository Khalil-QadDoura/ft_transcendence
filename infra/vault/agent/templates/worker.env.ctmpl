{{- /* worker env file (INF-13), rendered by vault-agent-worker into the tmpfs volume secrets-worker and sourced by with-secrets before celery. The worker needs JWT_SECRET only because the shared settings require it. Each line is NAME='value' with any ' in the value written as '\'' so that sh sources it unchanged. Never committed with values: Vault fills them in at render time. */ -}}
{{ with secret "secret/data/worker/jwt" }}JWT_SECRET='{{ .Data.data.value | replaceAll "'" "'\\''" }}'
{{ end }}
{{- with secret "secret/data/worker/db" }}DATABASE_URL='{{ printf "postgresql+asyncpg://%s:%s@db:5432/%s" (env "POSTGRES_USER") .Data.data.password (env "POSTGRES_DB") | replaceAll "'" "'\\''" }}'
{{ end }}
{{- with secret "secret/data/worker/minio" }}MINIO_ACCESS_KEY='{{ .Data.data.access_key | replaceAll "'" "'\\''" }}'
MINIO_SECRET_KEY='{{ .Data.data.secret_key | replaceAll "'" "'\\''" }}'
{{ end }}
{{- with secret "secret/data/worker/openai" }}OPENAI_API_KEY='{{ .Data.data.api_key | replaceAll "'" "'\\''" }}'
{{ end }}
