{{- /* api env file (INF-13), rendered by vault-agent-api into the tmpfs volume secrets-api and sourced by with-secrets before uvicorn. POSTGRES_USER and POSTGRES_DB are not secret: compose passes them to the agent. Each line is NAME='value' with any ' in the value written as '\'' so that sh sources it unchanged. Never committed with values: Vault fills them in at render time. */ -}}
{{ with secret "secret/data/api/jwt" }}JWT_SECRET='{{ .Data.data.value | replaceAll "'" "'\\''" }}'
{{ end }}
{{- with secret "secret/data/api/internal-api-key" }}INTERNAL_API_KEY='{{ .Data.data.value | replaceAll "'" "'\\''" }}'
{{ end }}
{{- with secret "secret/data/api/db" }}DATABASE_URL='{{ printf "postgresql+asyncpg://%s:%s@db:5432/%s" (env "POSTGRES_USER") .Data.data.password (env "POSTGRES_DB") | replaceAll "'" "'\\''" }}'
{{ end }}
{{- with secret "secret/data/api/minio" }}MINIO_ACCESS_KEY='{{ .Data.data.access_key | replaceAll "'" "'\\''" }}'
MINIO_SECRET_KEY='{{ .Data.data.secret_key | replaceAll "'" "'\\''" }}'
{{ end }}
{{- with secret "secret/data/api/oauth42" }}FT_CLIENT_SECRET='{{ .Data.data.client_secret | replaceAll "'" "'\\''" }}'
{{ end }}
