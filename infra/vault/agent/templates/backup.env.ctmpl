{{- /* backup env file (INF-13), rendered by vault-agent-infra into the tmpfs volume secrets-backup and sourced by infra/backup/backup.sh itself. Each line is NAME='value' with any ' in the value written as '\'' so that sh sources it unchanged. Never committed with values: Vault fills them in at render time. */ -}}
{{ with secret "secret/data/infra/backup" }}PGPASSWORD='{{ .Data.data.pg_password | replaceAll "'" "'\\''" }}'
MINIO_ROOT_USER='{{ .Data.data.minio_root_user | replaceAll "'" "'\\''" }}'
MINIO_ROOT_PASSWORD='{{ .Data.data.minio_root_password | replaceAll "'" "'\\''" }}'
{{ end }}
