{{- /* api-test env file (INF-13), rendered by vault-agent-api from the api's own paths into the tmpfs volume secrets-api-test, for make test. TEST_DATABASE_URL is the test database; make test points DATABASE_URL at it before pytest. Each line is NAME='value' with any ' in the value written as '\'' so that sh sources it unchanged. Never committed with values: Vault fills them in at render time. */ -}}
{{ with secret "secret/data/api/jwt" }}JWT_SECRET='{{ .Data.data.value | replaceAll "'" "'\\''" }}'
{{ end }}
{{- with secret "secret/data/api/internal-api-key" }}INTERNAL_API_KEY='{{ .Data.data.value | replaceAll "'" "'\\''" }}'
{{ end }}
{{- with secret "secret/data/api/db" }}DATABASE_URL='{{ printf "postgresql+asyncpg://%s:%s@db:5432/%s" (env "POSTGRES_USER") .Data.data.password (env "POSTGRES_DB") | replaceAll "'" "'\\''" }}'
TEST_DATABASE_URL='{{ printf "postgresql+asyncpg://%s:%s@db:5432/%s" (env "POSTGRES_USER") .Data.data.password (env "POSTGRES_TEST_DB") | replaceAll "'" "'\\''" }}'
{{ end }}
{{- with secret "secret/data/api/minio" }}MINIO_ACCESS_KEY='{{ .Data.data.access_key | replaceAll "'" "'\\''" }}'
MINIO_SECRET_KEY='{{ .Data.data.secret_key | replaceAll "'" "'\\''" }}'
{{ end }}
