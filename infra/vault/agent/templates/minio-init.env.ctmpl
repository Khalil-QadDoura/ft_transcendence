{{- /* minio-init env file (INF-13), rendered by vault-agent-infra into the tmpfs volume secrets-minio-init and sourced by with-secrets before infra/minio/init-bucket.sh. Each line is NAME='value' with any ' in the value written as '\'' so that sh sources it unchanged. Never committed with values: Vault fills them in at render time. */ -}}
{{ with secret "secret/data/infra/minio" }}MINIO_ROOT_USER='{{ .Data.data.root_user | replaceAll "'" "'\\''" }}'
MINIO_ROOT_PASSWORD='{{ .Data.data.root_password | replaceAll "'" "'\\''" }}'
{{ end }}
