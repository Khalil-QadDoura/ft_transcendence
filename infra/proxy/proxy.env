# Settings for the image's entrypoint, passed to the proxy container with env_file.
# No secrets here. Everything not listed keeps the image's default (see README.md).

# The WAF blocks (INF-11; docs/infra/waf.md). DetectionOnly would only log; Off skips it.
MODSEC_RULE_ENGINE=On

# OWASP CRS paranoia level 2 (of 1 to 4): the level 1 rules plus stricter ones that catch
# more attacks and also more normal text. Our false positives at level 2 are lifted one
# rule, one field and one path at a time in infra/proxy/modsecurity/before-crs.conf.
# DETECTION_PARANOIA above BLOCKING_PARANOIA would log higher-level matches without
# blocking on them; equal, every rule that runs also counts toward blocking.
BLOCKING_PARANOIA=2
DETECTION_PARANOIA=2

# Anomaly scoring: each matching rule adds its severity to the request's score (critical 5,
# error 4, warning 3, notice 2) and the request is refused (403) when the total reaches
# the threshold. 5 inbound = a single critical match blocks a request (the CRS default and
# the strict end); 4 outbound = a single error-level match (for example a leaked stack
# trace or SQL error) blocks a response. Both are written out, though they are the image's
# defaults, so the threshold is visible here and the check (make waf-check) can compare.
ANOMALY_INBOUND=5
ANOMALY_OUTBOUND=4

# What the app sends, and nothing else. The CRS defaults are GET HEAD POST OPTIONS (so
# PUT, PATCH and DELETE were refused, rule 911100) and also forms, multipart and XML types
# the app never sends. Methods: the API uses GET, POST, PATCH and DELETE, uploads PUT
# (presigned, /files), HEAD comes with GET. No OPTIONS: everything is same-origin, so no
# CORS preflight. Content types: JSON (API, Grafana, Mailpit), the avatar and logo types
# the API accepts (jpg, png, webp) and video/mp4 for intro videos. Anything else gets the
# WAF's 403 (rules 911100 and 920420). A request without a body has no type and passes.
ALLOWED_METHODS=GET HEAD POST PUT PATCH DELETE
ALLOWED_REQUEST_CONTENT_TYPE=|application/json| |image/jpeg| |image/png| |image/webp| |video/mp4|

# Audit log parts (PO decision, byul-byul, 2026-11-17, INF-07): A (client IP, time, unique
# id, request line), H (matched rules and scores), Z (end). The image default ABIJDEFHZ also
# writes every request header (B: Authorization and Cookie, so passwords and session
# tokens), request bodies (I, J) and the response (E, F). Never B, I, J or E: tuning reads
# the rule ids and fields from H (docs/infra/waf.md, "Reading an audit line").
MODSEC_AUDIT_LOG_PARTS=AHZ

# A self-signed certificate has no issuer to staple a response from.
SSL_OCSP_STAPLING=off

# Host port of HTTPS, for the HTTP -> HTTPS redirect. Compose overrides it from HTTPS_PORT
# in .env; this default keeps a plain `docker run` of the proxy working.
PUBLIC_HTTPS_PORT=443
