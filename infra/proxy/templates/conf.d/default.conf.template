# WOZU front proxy: one HTTPS origin in front of every service (INF-01).
#
# Replaces the image's conf.d/default.conf.template; the image renders ${VARS} with
# envsubst at start. ModSecurity + CRS stay on for all of this through the image's own
# conf.d/modsecurity.conf, which is not touched here.

server_tokens ${SERVER_TOKENS};
more_set_headers 'Server: ${SERVER_HEADER}';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Host port for HTTPS (compose sets it from HTTPS_PORT in .env). The redirect names it
# unless it is the default 443; $host never carries a port.
map "${PUBLIC_HTTPS_PORT}" $https_port_suffix {
    "443"   "";
    default ":${PUBLIC_HTTPS_PORT}";
}

# Plain HTTP only redirects.
server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};

    return 301 https://$host$https_port_suffix$request_uri;
}

server {
    listen ${SSL_PORT} ssl;
    server_name ${SERVER_NAME};

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_session_timeout 1d;
    ssl_session_cache shared:MozSSL:10m;
    ssl_session_tickets off;

    ssl_dhparam /etc/ssl/certs/dhparam-${SSL_DH_BITS}.pem;

    ssl_protocols ${SSL_PROTOCOLS};
    ssl_ciphers ${SSL_CIPHERS};
    ssl_prefer_server_ciphers ${SSL_PREFER_CIPHERS};

    ssl_stapling ${SSL_OCSP_STAPLING};
    ssl_stapling_verify ${SSL_OCSP_STAPLING};

    # Video upload size for /files; /api tightens it. Set here rather than on /files so
    # the image's internal /50x.html accepts the same bodies: with a lower limit, an
    # upload during a MinIO outage would be answered 413 instead of 502.
    client_max_body_size 60m;

    # nginx's own redirects (/mail -> /mail/, also /files, /api, /grafana) send a relative
    # Location. An absolute one carries no port (the image sets port_in_redirect off), so
    # with HTTPS_PORT=18443 /mail would land on https://localhost/mail/.
    absolute_redirect off;

    # Inherited by every location below, so no location sets its own proxy_set_header.
    # Host stays as the browser sent it, port included: MinIO presigned signatures and
    # the Grafana origin check both depend on it.
    proxy_http_version 1.1;
    proxy_redirect off;
    proxy_set_header Host $http_host;
    proxy_set_header Proxy "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Each proxy_pass takes a variable with no URI part. That has two effects:
    # - the name is resolved per request (Docker DNS, see `resolver` in nginx.conf), so
    #   the proxy starts without its upstreams and a missing one is a 502 on its route;
    # - the request URI goes upstream exactly as the client sent it, with no prefix strip.

    location / {
        set $upstream http://frontend:80;
        proxy_pass $upstream;
    }

    location /api/ {
        set $upstream http://api:8000;
        proxy_pass $upstream;
        client_max_body_size 1m;
    }

    location /ws {
        set $upstream http://api:8000;
        proxy_pass $upstream;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /files/ {
        set $upstream http://minio:9000;
        proxy_pass $upstream;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_body_timeout 60s;

        # A video is larger than SecRequestBodyLimit: inspect up to the limit and pass the
        # rest instead of rejecting. Not `SecRequestBodyAccess Off`, which also skips the
        # phase 2 rules, so an SQL injection in the query string would go unseen.
        modsecurity_rules 'SecRequestBodyLimitAction ProcessPartial';

        # MinIO answers with the Content-Type the uploader sent, so an uploaded HTML page
        # would open as a page of our origin. sandbox stops scripts in anything opened from
        # here; it does not affect <img> or <video>. MinIO sends its own nosniff, hidden so
        # the response carries one copy, ours. An add_header here drops every add_header
        # of the server and http levels; there are none (nginx -T), so nothing is lost.
        proxy_hide_header X-Content-Type-Options;
        add_header Content-Security-Policy "sandbox" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Both UIs keep a WebSocket open (Grafana Live, Mailpit events).
    location /grafana/ {
        set $upstream http://grafana:3000;
        proxy_pass $upstream;
        proxy_read_timeout 3600s;
    }

    location /mail/ {
        set $upstream http://mailpit:8025;
        proxy_pass $upstream;
        proxy_read_timeout 3600s;
    }

    # A regex wins over prefix locations, so this also hides the image's /metrics/nginx.
    # The API mounts /_internal at the root and BE-30 plans /metrics there too; the /api/
    # variants are closed as well, so a router mounted under /api by mistake stays inside.
    # Matched after nginx decodes and normalizes the path (/api/../_internal, /%5Finternal).
    location ~ ^/(api/)?(_internal|metrics)(/|$) {
        return 404;
    }

    # The image's /healthz (used by its HEALTHCHECK) and error pages.
    include includes/location_common.conf;
}
