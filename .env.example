# Settings for the root docker-compose.yml. `make` (scripts/init-env.sh) copies this file
# to .env once and fills the empty secrets marked "Generated" with random values; it never
# overwrites an existing .env. .env is git-ignored and never committed.
# The only value a human adds is OPENAI_API_KEY.
# Comments stay on their own lines: compose would read "# ..." after a value as part of it.

# --- Front proxy (the only service with host ports) ---

# Host name the proxy answers to (nginx server_name). The certificate covers localhost only.
DOMAIN=localhost
# Host ports for HTTPS and for the HTTP -> HTTPS redirect. Change them if 443 or 80 are taken,
# then `make re`. A non-default HTTPS port must also go into FRONTEND_BASE_URL and
# MINIO_EXTERNAL_ENDPOINT below, e.g. https://localhost:8443.
HTTPS_PORT=443
HTTP_PORT=80

# --- API (and the worker, which runs the same image) ---

# dev shows Swagger at /api/docs; prod hides it.
ENV=dev
# Log level of the API: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Public address of the site, used in email links (/verify-email, /reset-password).
FRONTEND_BASE_URL=https://localhost
# Key that signs the login tokens, at least 32 characters. Generated.
JWT_SECRET=
# Shared secret for /_internal/* routes (X-Internal-Key header); empty closes them. Generated.
INTERNAL_API_KEY=

# --- Database (PostgreSQL + PostGIS) ---

# Owner and name of the app database, created on the first start of the db volume.
POSTGRES_USER=wozu
POSTGRES_DB=wozu
# Password of POSTGRES_USER. Generated. Changing it later needs `make fclean` (new volume).
POSTGRES_PASSWORD=
# Name of the separate test database (BE-20); it is not created yet.
POSTGRES_TEST_DB=wozu_test
# docker-compose.yml builds DATABASE_URL and TEST_DATABASE_URL for the API from the four
# values above, so the password is written only once.

# --- Object storage (MinIO) ---

# MinIO admin user and password. The password is generated.
MINIO_ROOT_USER=wozu
MINIO_ROOT_PASSWORD=
# Bucket for videos, avatars and logos, served at /files (created in INF-04).
MINIO_BUCKET=files
# Base URL the API signs upload and download URLs for: the public HTTPS origin.
MINIO_EXTERNAL_ENDPOINT=https://localhost

# --- Email (Mailpit catches every message; inbox at /mail) ---

# SMTP server the API sends through: the mailpit container.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Sender address on every email.
MAIL_FROM=no-reply@wozu.local

# --- Monitoring ---

# Grafana admin password (Grafana joins the stack in INF-09). Generated.
GRAFANA_ADMIN_PASSWORD=

# --- Video moderation (worker) ---

# OpenAI key for transcription and moderation. Add it by hand; nothing else needs a human.
OPENAI_API_KEY=
# true lets videos through when the OpenAI check fails; keep false on defense day.
MODERATION_FAIL_OPEN=false
