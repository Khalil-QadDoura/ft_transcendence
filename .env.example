# Settings for the root docker-compose.yml. `make` (scripts/init-env.sh) copies this file
# to .env once. It never changes a line of an existing .env; it only appends the keys added
# here since. .env is git-ignored and never committed.
# No secret lives here (INF-13): the JWT key, the internal API key and the database, MinIO
# and Grafana passwords are generated in Vault by `make` (scripts/vault-init.sh) and reach
# the services through Vault Agent (docs/infra/vault.md). A secret still found in .env (an
# older .env) is moved into Vault by `make` and its line removed.
# The only values a human adds are OPENAI_API_KEY and, for login with 42, FT_CLIENT_ID and
# FT_CLIENT_SECRET.
# Comments stay on their own lines: compose would read "# ..." after a value as part of it.

# --- Front proxy (the only service with host ports) ---

# Host name the proxy answers to (nginx server_name). The certificate covers localhost only.
DOMAIN=localhost
# Host ports for HTTPS and for the HTTP -> HTTPS redirect. Change them if 443 or 80 are taken,
# then `make` (or `HTTPS_PORT=8443 make`): it writes a non-default HTTPS port into
# FRONTEND_BASE_URL and MINIO_EXTERNAL_ENDPOINT below, e.g. https://localhost:8443.
HTTPS_PORT=443
HTTP_PORT=80

# --- API (and the worker, which runs the same image) ---

# dev shows Swagger at /api/docs; prod hides it.
ENV=dev
# Log level of the API: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Public address of the site, used in email links (/verify-email, /reset-password) and for
# Grafana's root URL (this value + /grafana/).
FRONTEND_BASE_URL=https://localhost
# JWT_SECRET (signs the login tokens) and INTERNAL_API_KEY (X-Internal-Key of /_internal/*)
# are in Vault (secret/api/jwt, secret/worker/jwt, secret/api/internal-api-key).

# --- Database (PostgreSQL + PostGIS) ---

# Owner and name of the app database, created on the first start of the db volume.
POSTGRES_USER=wozu
POSTGRES_DB=wozu
# The password of POSTGRES_USER is in Vault (secret/infra/db and a copy for each service
# that logs in). The db image sets it only when its volume is new.
# Separate database for the backend tests (TEST_DATABASE_URL), owned by POSTGRES_USER; the
# name must contain "test". Created with PostGIS on the first start of the db volume, and
# by `make test` when it is missing (infra/db/create-test-db.sh).
POSTGRES_TEST_DB=wozu_test
# Vault Agent builds DATABASE_URL and TEST_DATABASE_URL for the API and the worker from
# these names and the password in Vault (infra/vault/agent/templates/).

# --- Object storage (MinIO) ---

# The MinIO admin user and password are in Vault (secret/infra/minio; the API and the worker
# get them as MINIO_ACCESS_KEY / MINIO_SECRET_KEY from secret/api/minio, secret/worker/minio).
# Bucket for videos, avatars and logos; minio-init creates it on every start. Keep it
# "files": the browser reaches it at https://<host>/files/<key>, so the bucket name is the
# proxy route.
MINIO_BUCKET=files
# Base URL the API signs upload and download URLs for: the public HTTPS origin, with the
# port when HTTPS_PORT is not 443. Inside the containers this address is the container
# itself, so server-side reads and writes use minio:9000 (set in docker-compose.yml).
MINIO_EXTERNAL_ENDPOINT=https://localhost
# Region the API signs URLs with. Given explicitly, so the SDK does not ask the endpoint
# for the bucket region; us-east-1 is what MinIO reports by default.
MINIO_REGION=us-east-1

# --- Email (Mailpit catches every message; inbox at /mail) ---

# SMTP server the API sends through: the mailpit container.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Sender address on every email.
MAIL_FROM=no-reply@wozu.local
# No BREVO_API_KEY on purpose: the defense uses Mailpit only, so the API always sends over
# SMTP (PO decision 2026-11-08).

# --- Monitoring ---

# The password of the Grafana user admin at https://<host>/grafana/ (INF-09) is in Vault
# (secret/infra/grafana); `docker compose exec grafana cat /run/vault/admin-password` shows it.
# Grafana sets it when its grafana-data volume is new (see M12 in docs/infra/infrastructure.md).

# --- Backups (INF-14) ---

# Time of the daily backup of the database and the bucket, HH:MM in Asia/Dubai (the backup
# service runs with TZ=Asia/Dubai). The card's BACKUP_CRON became this: the service sleeps
# in a loop, there is no cron daemon to read a cron line. `make backup` runs one at any time.
BACKUP_TIME=03:00
# After each run, copies older than BACKUP_MAX_AGE_DAYS days (by the UTC time in their name)
# are deleted, then at most the newest BACKUP_KEEP of each kind (database dumps, bucket
# copies) are kept. 7 and 7 are the decided values: the Privacy Policy (section 6) promises
# that backups are kept for at most 7 days.
BACKUP_KEEP=7
BACKUP_MAX_AGE_DAYS=7

# --- Video moderation (worker) ---

# OpenAI key for transcription and moderation. Add it by hand (as the 42 keys below): moved
# into Vault by make, then removed from this file (the empty line stays for the next one).
OPENAI_API_KEY=
# true lets videos through when the OpenAI check fails; keep false on defense day.
MODERATION_FAIL_OPEN=false

# --- Login with 42 (OAuth 2.0, BE-11) ---

# Keys of our app in the 42 intra app settings (UID, SECRET), added by hand; empty = off.
# Its redirect URI there: https://localhost/api/auth/oauth/42/callback.
FT_CLIENT_ID=
# The SECRET: moved into Vault by make, then removed from this file (the empty line stays).
FT_CLIENT_SECRET=

# --- Vault (INF-12, INF-13) ---

# Address the Vault Agents reach Vault at, on the Docker network. Not secret.
VAULT_ADDR=http://vault:8200
