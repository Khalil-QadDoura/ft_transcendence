# Backend settings. Copy to backend/.env for a local run; .env is never committed.

# dev shows Swagger at /api/docs; prod (the default when unset) hides it.
ENV=dev

# Async SQLAlchemy URL (asyncpg driver). In Docker Compose the host is the "db" service.
DATABASE_URL=postgresql+asyncpg://wozu:change-me@db:5432/wozu

# Dedicated test database URL. Tests run inside rollback transactions on this database.
TEST_DATABASE_URL=postgresql+asyncpg://wozu_test:change-me@db:5432/wozu_test

LOG_LEVEL=INFO

# Shared secret for /_internal/* routes, sent as the X-Internal-Key header.
# Empty means every internal route answers 404. Generate one with: openssl rand -hex 32
INTERNAL_API_KEY=

# Signs the login tokens (JWTs). Required: the API refuses to start while it is empty.
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# The frontend's address. Links in emails open its pages, e.g. /verify-email?token=...
FRONTEND_BASE_URL=https://localhost

# Outgoing email over SMTP. These defaults point at the Mailpit container (INF-05), which
# catches every email; read them in its web inbox at https://localhost/mail.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@wozu.local
# Optional: a Brevo API key sends emails to real inboxes instead (MAIL_FROM must then be a
# sender verified in the Brevo account). Leave empty to use SMTP.
BREVO_API_KEY=
